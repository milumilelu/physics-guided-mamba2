-            print('   x=%-6.0f fs=%-4.0f 半宽=%-6.0f [%.0f,%.0f] %r%s'
-                  % (x, fs, half, x - half, x + half, txt[:34], flag))
-
-        # ---- 3. 硬编码色号 ----
-        cols = collections.Counter(re.findall(r'#[0-9A-Fa-f]{6}', src))
-        print('[配色] 出现色号:', dict(cols))
